{
  "name": "folklore-lab",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @folklore/web dev",
    "dev:studio": "pnpm --filter @folklore/studio dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
