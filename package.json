{
  "name": "folklore-lab",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @folklore/web dev",
    "dev:studio": "pnpm --filter @folklore/studio dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
